#Programa que checa cual de los 3 valores en mayor

a=int(input("Enter a value : "))
b=int(input("Enter b value : "))
c=int(input("Enter c value : "))

if (a>b) and (a>c):
    print("Maximum value is: a=",a)
elif(b>a) and (b>c):
    print("Maximum value is: b=",b)
else:
    print("Maximum value is: c=",c)
