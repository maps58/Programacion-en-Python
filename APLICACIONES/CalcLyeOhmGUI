
import tkinter as tk
from tkinter import messagebox
from PIL import Image, ImageTk

def pedir_datos1():
    messagebox.showinfo(
        "Cálculo de voltaje",
        "Ingresar el valor de corriente y resistencia")
def pedir_datos2():
    messagebox.showinfo(
        "Cálculo de corriente",
        "Ingresar el valor de voltaje y resistencia")
    
def pedir_datos3():
    messagebox.showinfo(
        "Cálculo de resistencia",        
        "Ingresar el valor de voltaje y corriente")


def main():

    # Crear la ventana principal
    root = tk.Tk()
    root.title("CALCULADORA DE LA LEY DE OHM")
    root.configure(background="white")
    root.geometry("500x400")

    # Función para obtener los valores de entrada
    def obtener_valor(entry):
        return float(entry.get())

    # Función para mostrar un resultado en un Entry
    def mostrar_resultado(entry, valor):
        entry.delete(0, tk.END)
        entry.insert(0, f"{valor:.2f}")

    # Calcular voltaje: V = I * R
    def calcular_voltaje():
        try:
            I = obtener_valor(entry2)
            R = obtener_valor(entry3)

            V = I * R
            mostrar_resultado(entry1, V)

        except ValueError:
            messagebox.askretrycancel(
                "Error",
                "Ingresa valores numéricos en Corriente y Resistencia.")

    # Calcular corriente: I = V / R
    def calcular_corriente():
        try:
            V = obtener_valor(entry1)
            R = obtener_valor(entry3)

            if R == 0:
                raise ZeroDivisionError

            I = V / R
            mostrar_resultado(entry2, I)

        except ValueError:
            messagebox.askretrycancel(
                "Error",
                "Ingresa valores numéricos en Voltaje y Resistencia.")
        except ZeroDivisionError:
            messagebox.askretrycancel(
                "Error",
                "La resistencia no puede ser cero.")

    # Calcular resistencia: R = V / I
    def calcular_resistencia():
        try:
            V = obtener_valor(entry1)
            I = obtener_valor(entry2)

            if I == 0:
                raise ZeroDivisionError

            R = V / I
            mostrar_resultado(entry3, R)

        except ValueError:
            messagebox.askretrycancel(
                "Error",
                "Ingresa valores numéricos en Voltaje y Corriente."
            )
        except ZeroDivisionError:
            messagebox.showerror(
                "Error",
                "La corriente no puede ser cero.")

    # Etiqueta principal
    label = tk.Label(
        root,
        text="***CALCULADORA DE LA LEY DE OHM***",
        font=("Courier New", 12, "bold"),
        bg="white"
    )
    label.grid(row=0, column=0, columnspan=3, pady=10, padx=10)

    # Etiqueta secundaria
    label1 = tk.Label(
        root,
        text="¿Qué parámetro del circuito desea calcular?",
        font=("Courier New", 10, "bold"),
        relief="ridge",
        bg="antiquewhite3",
        width=60
    )
    label1.grid(row=3, column=0, columnspan=3, pady=20, padx=10)

    # Cargar el logotipo
    try:
        image = Image.open("ito_logo.png")
        image = image.resize((100, 100))
        logo = ImageTk.PhotoImage(image)

        image_label = tk.Label(root, image=logo, bg="white")
        image_label.grid(row=1, column=0, columnspan=3, pady=10)
        image_label.image = logo

    except FileNotFoundError:
        print("No se encontró el archivo ito_logo.png")

    # Botón para calcular voltaje
    button1 = tk.Button(
        root,
        text="Voltaje",
        bg="antiquewhite",
        width=15,
        command=calcular_voltaje
    )

    # Botón para calcular corriente
    button2 = tk.Button(
        root,
        text="Corriente",
        bg="antiquewhite",
        width=15,
        command=calcular_corriente
    )

    # Botón para calcular resistencia
    button3 = tk.Button(
        root,
        text="Resistencia",
        bg="antiquewhite",
        width=15,
        command=calcular_resistencia
    )

    # Colocar los botones
    button1.grid(row=4, column=0, padx=10, pady=15)
    button2.grid(row=4, column=1, padx=10, pady=15)
    button3.grid(row=4, column=2, padx=10, pady=15)

    # Campo para voltaje
    entry1 = tk.Entry(
        root, width=15, justify="center",
        font=("Courier New", 10)
    )
    entry1.grid(row=5, column=0, padx=5, pady=5)

    # Campo para corriente
    entry2 = tk.Entry(
        root, width=15, justify="center",
        font=("Courier New", 10)
    )
    entry2.grid(row=5, column=1, padx=5, pady=5)

    # Campo para resistencia
    entry3 = tk.Entry(
        root, width=15, justify="center",
        font=("Courier New", 10)
    )
    entry3.grid(row=5, column=2, padx=5, pady=5)

    # Autor
    label_autor = tk.Label(
        root,
        text="Código hecho por MIGUEL ANGEL PEREZ SOLANO",
        font=("Courier New", 9, "italic", "bold"),
        fg="navy",
        bg="white"
    )
    label_autor.grid(row=8, column=0, columnspan=3, pady=(10, 2))

    # Departamento
    label_departamento = tk.Label(
        root,
        text="Departamento de Ingeniería Eléctrica y Electrónica",
        font=("Courier New", 8),
        fg="navy",
        bg="white"
    )
    label_departamento.grid(
        row=9, column=0, columnspan=3, pady=2
    )

    # Iniciar la interfaz gráfica
    root.mainloop()


if __name__ == "__main__":
    main()
