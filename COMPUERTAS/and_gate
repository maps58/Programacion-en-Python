
# Definir la funcion de una compuerta AND
def and_gate(input_a, input_b):
    return input_a & input_b  # Bitwise AND operator

# Prueba de la compuerta AND
inputs = [(0, 0), (0, 1), (1, 0), (1, 1)]
print("Input A | Input B | Output")
for input_a, input_b in inputs:
    output = and_gate(input_a, input_b)
    print(f"   {input_a}    |    {input_b}    |    {output}")

