#Código para crear una señal senoidal.
import matplotlib.pyplot as plt
import numpy as np

# Create sample data
x = np.linspace(0, 10, 100)
y = np.sin(x)

# Create line chart
plt.figure(figsize=(10, 6))
plt.plot(x, y, linewidth=2)
plt.title('Time Series Analysis Example')
plt.xlabel('Time')
plt.ylabel('Value')
plt.grid(True)
plt.show()


